<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0B0F14">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LogiPanel — LOGO! 8.4 Modbus TCP"
        android:textColor="#FFB020"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/ipInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="عنوان IP لجهاز LOGO! (مثال 192.168.0.10)"
        android:textColorHint="#6B7A8A"
        android:textColor="#DBE4EC"
        android:inputType="text"/>

    <EditText
        android:id="@+id/portInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="المنفذ (Port) — الافتراضي 502"
        android:textColorHint="#6B7A8A"
        android:textColor="#DBE4EC"
        android:inputType="number"
        android:text="502"/>

    <EditText
        android:id="@+id/unitIdInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unit ID — الافتراضي 1"
        android:textColorHint="#6B7A8A"
        android:textColor="#DBE4EC"
        android:inputType="number"
        android:text="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="اتصال"/>

        <Button
            android:id="@+id/addPointBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ نقطة جديدة"/>
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="غير متصل"
        android:textColor="#FF5D5D"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/pointsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

</LinearLayout>
